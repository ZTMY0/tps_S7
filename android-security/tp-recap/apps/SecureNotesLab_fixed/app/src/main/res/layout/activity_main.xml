<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="24dp" android:paddingRight="24dp" android:paddingBottom="24dp" android:paddingTop="130dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SecureNotesLab"
        android:textSize="22sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/buttonProfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Voir mon profil (zone interne)" />

    <Button
        android:id="@+id/buttonNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Ouvrir ma note" />

    <Button
        android:id="@+id/buttonDossier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Mon dossier" />

</LinearLayout>
