<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.lab.securenotes.permission.READ_NOTES" />

    <!-- Android 11+ : necessaire pour voir/lancer SecureNotesLab -->
    <queries>
        <package android:name="com.lab.securenotes" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="AttackLab"
        android:theme="@style/Theme.AttackLab">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".QueryReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.lab.attacklab.QUERY_NOTES" />
            </intent-filter>
        </receiver>


    </application>
</manifest>


