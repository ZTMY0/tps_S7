FUNCTION            chercher_client(p_nom IN VARCHAR2)
  RETURN VARCHAR2 AS v_res VARCHAR2(400);
BEGIN
  EXECUTE IMMEDIATE
    'SELECT MAX(last_name) FROM customers WHERE last_name = :1'
    INTO v_res USING p_nom;
  RETURN NVL(v_res, '(aucun)');
END;

